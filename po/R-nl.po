msgid ""
""
"Custom steps for predicted survival time were specified in an incorrect"
"format. Try '0.25, 0.50, 0.75'."
msgstr ""
"Aangepaste stappen voor de voorspelde overlevingstijd zijn in een"
"onjuiste indeling gespecificeerd. Probeer '0,25; 0,50; 0,75'."

msgid "Custom steps for predicted survival time must be between 0 and 1."
msgstr ""
"Aangepaste stappen voor de voorspelde overlevingstijd moeten tussen 0"
"en 1 liggen."

msgid "Step from for predicted survival time must be a positive number."
msgstr ""
"Stap vanaf voor de voorspelde overlevingstijd moet een positief getal"
"zijn."

msgid "Step to for predicted survival time must be a positive number."
msgstr ""
"Stap tot voor de voorspelde overlevingstijd moet een positief getal"
"zijn."

msgid "Step size for predicted survival time must be a positive number."
msgstr ""
"Stapgrootte voor de voorspelde overlevingstijd moet een positief getal"
"zijn."

msgid "Custom steps for predicted survival time must be greater than or equal to 0."
msgstr ""
"Aangepaste stappen voor de voorspelde overlevingstijd moeten groter"
"dan of gelijk aan 0 zijn."

msgid "%1$s model %2$s%3$s failed with the following message: %4$s."
msgstr "Het %1$s-model %2$s%3$s is mislukt met de volgende melding: %4$s."

msgid "All following output is based on the best fitting %1$s distribution."
msgstr "Alle volgende uitvoer is gebaseerd op de best passende %1$s-verdeling."

msgid ""
""
"Results are based on %1$s distribution which was the best fitting"
"distribution."
msgstr ""
"De resultaten zijn gebaseerd op de %1$s-verdeling die de best passende"
"verdeling was."

msgid "Results are based on %1$s."
msgstr "De resultaten zijn gebaseerd op %1$s."

msgid ""
""
"Results are based on %1$s with distribution %2$s which is the best fitting"
"distribution across models."
msgstr ""
"De resultaten zijn gebaseerd op %1$s met verdeling %2$s die de best"
"passende verdeling over de modellen is."

msgid "Results are based on best fitting models."
msgstr "De resultaten zijn gebaseerd op de best passende modellen."

msgid "Results are based on best fitting models within each distribution."
msgstr ""
"De resultaten zijn gebaseerd op de best passende modellen binnen elke"
"verdeling."

msgid ""
""
"Results are based on %1$s with %2$s distribution which was the best fitting"
"model across all models and distributions."
msgstr ""
"De resultaten zijn gebaseerd op %1$s met %2$s-verdeling die het best"
"passende model over alle modellen en verdelingen was."

