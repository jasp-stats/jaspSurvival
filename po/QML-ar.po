msgstr ""
"تخصيص لوحة الألوان المستخدمة في المخطط. يتوفر فقط عند تحديد متغيرات الطبقات."

msgctxt "SurvivalPlot|"
msgid "Theme"
msgstr "السمة"

msgctxt "SurvivalPlot|"
msgid ""
