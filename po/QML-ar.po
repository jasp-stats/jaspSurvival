msgstr "تحديد قيمة الكمية (بين 0 و1) التي يُضاف عندها الخط الرأسي إلى المخطط."

msgctxt "SurvivalPlot|"
msgid "Legend"
msgstr "مفتاح الرسم"

msgctxt "SurvivalPlot|"
msgid ""
