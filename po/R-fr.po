msgid ""
"Custom steps for predicted survival time were specified in an incorrect"
"format. Try '0.25, 0.50, 0.75'."
msgstr "Des étapes personnalisées pour le temps de survie prédit ont été spécifiées dans un format incorrect. Essayez « 0,25, 0,50, 0,75 »."

msgid "Custom steps for predicted survival time must be between 0 and 1."
msgstr "Les étapes personnalisées pour le temps de survie prédit doivent être comprises entre 0 et 1."

msgid "Step from for predicted survival time must be a positive number."
msgstr "L'étape de départ pour le temps de survie prédit doit être un nombre positif."

msgid "Step to for predicted survival time must be a positive number."
msgstr "L'étape de fin pour le temps de survie prédit doit être un nombre positif."

msgid "Step size for predicted survival time must be a positive number."
msgstr "La taille de l'étape pour le temps de survie prédit doit être un nombre positif."

msgid "Custom steps for predicted survival time must be greater than or equal to 0."
msgstr "Les étapes personnalisées pour le temps de survie prédit doivent être supérieures ou égales à 0."

#, qt-format
msgid "%1$s model %2$s%3$s failed with the following message: %4$s."
msgstr "Le modèle %1$s %2$s%3$s a échoué avec le message suivant : %4$s."

#, qt-format
msgid "All following output is based on the best fitting %1$s distribution."
msgstr "Toute la sortie suivante est basée sur la distribution %1$s la mieux ajustée."

#, qt-format
msgid ""
"Results are based on %1$s distribution which was the best fitting"
"distribution."
msgstr "Les résultats sont basés sur la distribution %1$s qui était la mieux ajustée."

