msgid ""
"An open interval may use negative infinity for its start or positive "
"infinity for its end, but not the reverse."
msgstr "开区间可以用负无穷作为起点或用正无穷作为终点，但不能反过来。"

msgid "No observations remain after excluding missing values."
msgstr "排除缺失值后没有剩余观测。"

msgid "The end time must be larger than the start time."
msgstr "结束时间必须大于开始时间。"

msgid "The interval end must be greater than or equal to the interval start."
msgstr "区间终点必须大于或等于区间起点。"

msgid "The weights variable must be an integer."
msgstr "权重变量必须为整数。"

msgid "The weights variable must not contain missing values."
msgstr "权重变量不能包含缺失值。"

msgid "The weights variable must be positive."
msgstr "权重变量必须为正。"

msgid "%1$i observations omitted due to missing values."
msgstr "因缺失值而省略了 %1$i 个观测。"

msgid "Events"
msgstr "事件"

msgid "Censored"
msgstr "删失"

msgid "Left censored"
msgstr "左删失"

msgid "Right censored"
msgstr "右删失"

msgid "Interval censored"
msgstr "区间删失"

msgid "Censoring Summary"
msgstr "删失汇总"

msgid "Subgroup"
msgstr "子组"

msgid "Count"
msgstr "计数"

msgid "%1$s: non-finite values were exported as missing."
msgstr "%1$s：非有限值已作为缺失值导出。"

msgid "Export"
msgstr "导出"

msgid ""
"More than one export requests the column '%1$s'. Specify distinct export "
"prefixes."
msgstr "有多个导出请求列“%1$s”。请指定不同的导出前缀。"

msgid "The column '%1$s' already exists. Specify a different export prefix."
msgstr "列“%1$s”已存在。请指定不同的导出前缀。"

msgid "Message"
msgstr "消息"

msgid "Exported values could not be matched to the original observations."
msgstr "导出的值无法与原始观测匹配。"

msgid "Fitted mean survival time"
msgstr "拟合平均生存时间"

msgid "Response residual"
msgstr "响应残差"

msgid "Fitted median survival time"
msgstr "拟合中位生存时间"

msgid "Cox-Snell residual"
msgstr "Cox-Snell 残差"

msgid "Component %1$i probability"
msgstr "成分 %1$i 概率"

msgid "Component index"
msgstr "成分索引"

msgid "Martingale residual"
msgstr "鞅残差"

msgid "Deviance residual"
msgstr "偏差残差"

msgid "Fitted relative risk"
msgstr "拟合相对风险"

msgid "Fitted linear predictor"
msgstr "拟合线性预测子"

msgid "Full dataset"
msgstr "完整数据集"

msgid "Response"
msgstr "响应"

msgid "Cox-Snell"
msgstr "Cox-Snell"

msgid "Martingale Residuals"
msgstr "鞅残差"

msgid "Deviance Residuals"
msgstr "偏差残差"

msgid "Score Residuals"
msgstr "得分残差"

msgid "Schoenfeld Residuals"
msgstr "Schoenfeld 残差"

msgid "Scaled Schoenfeld Residuals"
msgstr "标度 Schoenfeld 残差"

msgid "Survival Plot"
msgstr "生存图"

msgid "Risk Plot"
msgstr "风险图"

msgid "Cumulative Hazard Plot"
msgstr "累积风险图"

msgid "Complementary Log-Log Plot"
msgstr "互补双对数图"

msgid "log(Time)"
msgstr "log(时间)"

msgid "Kaplan-Meier Summary Table"
msgstr "Kaplan-Meier 汇总表"

msgid "%s%% CI"
msgstr "%s%% 置信区间"

msgid "Strata"
msgstr "分层"

msgid "N"
msgstr "N"

msgid "Restricted Mean"
msgstr "受限均值"

msgid "Standard Error"
msgstr "标准误"

msgid "Median Survival"
msgstr "中位生存"

msgid "Lower"
msgstr "下限"

msgid "Upper"
msgstr "上界"

msgid "Tests Table"
msgstr "检验表"

msgid "Test"
msgstr "检验"

msgid "Chi Square"
msgstr "卡方"

msgid "df"
msgstr "自由度"

msgid "p"
msgstr "p"

msgid "At least one strata needs to be specified"
msgstr "至少需要指定一个分层"

msgid "Log-rank (Mantel-Haenszel)"
msgstr "Log-Rank（Mantel-Haenszel）"

msgid "Peto and Peto"
msgstr "Peto 与 Peto"

msgid "Flemming-Harrington"
msgstr "Fleming-Harrington"

msgid "Life Table"
msgstr "生命表"

msgid "Time"
msgstr "时间"

msgid "At Risk"
msgstr "处于风险中"

msgid "Survival"
msgstr "生存"

msgid "At least one starting value method must be selected."
msgstr "必须至少选择一种起始值方法。"

msgid "The mixture model requires all event times to be positive."
msgstr "混合模型要求所有事件时间均为正。"

msgid "No starting values could be constructed for the mixture model."
msgstr "无法为混合模型构建起始值。"

msgid "Fitting %1$s mixture (%2$i components)"
msgstr "正在拟合 %1$s 混合模型（%2$i 个成分）"

msgid "The mixture model could not be estimated from any starting value: %1$s"
msgstr "无法从任何起始值估计混合模型：%1$s"

msgid ""
"The component probabilities could not be evaluated accurately. Try a "
"different distribution or fewer components."
msgstr "无法准确计算成分概率。请尝试其他分布或减少成分数。"

msgid "The mixture model could not be finalized: %1$s"
msgstr "混合模型无法完成：%1$s"

msgid ""
"No constrained candidate converged. Try more starting values, a different "
"distribution, or fewer components."
msgstr "没有受约束的候选解收敛。请尝试更多起始值、其他分布或减少成分数。"

msgid "The log-likelihood is not finite."
msgstr "对数似然不是有限值。"

msgid "The EM algorithm produced no valid state."
msgstr "EM 算法未产生有效状态。"

msgid ""
"The mixture model requires events or positive censoring times. Check the "
"survival times and event status."
msgstr "混合模型要求存在事件或正的删失时间。请检查生存时间和事件状态。"

msgid ""
"A mixture component degenerated during the estimation. Consider fewer "
"components."
msgstr "估计过程中某个混合成分退化。请考虑减少成分数。"

msgid "Censoring type '%1$s' is not supported by the mixture model."
msgstr "混合模型不支持删失类型“%1$s”。"

msgid ""
"The initial parameters do not satisfy the minimum log-time standard "
"deviation."
msgstr "初始参数不满足最小对数时间标准差。"

msgid ""
"The selected solution could not be retained while computing its covariance. "
"Try a different distribution or fewer components."
msgstr "在计算协方差时无法保留所选解。请尝试其他分布或减少成分数。"

msgid "The log-likelihood of the mixture model is not finite."
msgstr "混合模型的对数似然不是有限值。"

msgid ""
"The likelihood may lose numerical precision at these censoring or entry "
"times. Results cannot be reported reliably. Try a different distribution or "
"fewer components."
msgstr ""
"在这些删失时间或进入时间上，似然可能损失数值精度，无法可靠报告结果。请尝试其"
"他分布或减少成分数。"

msgid ""
"A minimum log-time standard deviation is not available for %1$s. Select log-"
"normal, Weibull, log-logistic, or gamma."
msgstr ""
"%1$s 没有可用的最小对数时间标准差。请选择对数正态、Weibull、对数 Logistic 或 "
"Gamma。"

msgid ""
"The one-component reference model could not be fitted. Try a different "
"distribution or use an absolute minimum log-time standard deviation."
msgstr "无法拟合单成分参照模型。请尝试其他分布或使用绝对最小对数时间标准差。"

msgid ""
"The one-component reference model did not yield a converged, positive log-"
"time standard deviation. Try a different distribution or use an absolute "
"minimum log-time standard deviation."
msgstr ""
"单成分参照模型未得到收敛且为正的对数时间标准差。请尝试其他分布或使用绝对最小"
"对数时间标准差。"

msgid ""
"The fitted parameters do not satisfy the minimum log-time standard "
"deviation. Results cannot be reported reliably."
msgstr "拟合参数不满足最小对数时间标准差，无法可靠报告结果。"

msgid ""
"The constrained optimizer did not converge. Try a different distribution or "
"a simpler model."
msgstr "受约束优化器未收敛。请尝试其他分布或更简单的模型。"

msgid ""
"Some mixture quantiles could not be evaluated accurately and are shown as "
"missing."
msgstr "部分混合分位数无法准确计算，显示为缺失。"

msgid "Component Mean and Median"
msgstr "成分均值与中位数"

msgid "Mixture Classification"
msgstr "混合分类"

msgid "Estimation Diagnostics"
msgstr "估计诊断"

msgid "Mixture Components"
msgstr "混合成分"

msgid "Component"
msgstr "成分"

msgid "Estimate"
msgstr "估计值"

msgid ""
"Some component means or medians are infinite or could not be evaluated "
"numerically and are shown as missing."
msgstr "部分成分均值或中位数为无穷大或无法数值计算，显示为缺失。"

msgid ""
"Some standard errors or confidence intervals could not be evaluated and are "
"shown as missing."
msgstr "部分标准误或置信区间无法计算，显示为缺失。"

msgid "Standard errors and confidence intervals are based on the delta method."
msgstr "标准误和置信区间基于 delta 方法。"

msgid ""
"The component means and medians describe the baseline distribution at zero "
"fitted design. Treatment and SAS factor contrasts have zero design at their "
"omitted reference level; other contrasts can have a baseline that does not "
"correspond to an observed category."
msgstr ""
"成分均值和中位数描述拟合设计为零时的基线分布。处理对比和 SAS 因子对比在被省略"
"的参照水平上设计为零；其他对比的基线可能不对应任何观测类别。"

msgid ""
"The component means and medians correspond to the reference level of factors "
"and zero value of covariates."
msgstr "成分均值和中位数对应因子的参照水平和协变量的零值。"

msgid "Mixing probability"
msgstr "混合概率"

msgid "Mean"
msgstr "均值"

msgid "Median"
msgstr "中位数"

msgid "Component %1$i"
msgstr "成分 %1$i"

msgid "Classified"
msgstr "已分类"

msgid "Proportion"
msgstr "比例"

msgid "Mean posterior probability"
msgstr "平均后验概率"

msgid ""
"Observations are classified to the component with the highest posterior "
"probability. The relative entropy of the classification is %1$.3f (values "
"close to 1 indicate low uncertainty in the assignments)."
msgstr ""
"观测被分类到后验概率最高的成分。分类的相对熵为 %1$.3f（接近 1 表示归类的不确"
"定性低）。"

msgid "Distribution"
msgstr "分布"

msgid "Model"
msgstr "模型"

msgid "Components"
msgstr "成分"

msgid "Starts"
msgstr "起始值"

msgid "Failed Starts"
msgstr "失败的起始值"

msgid "Replications"
msgstr "重复次数"

msgid "Log Lik."
msgstr "对数似然"

msgid "Next Best Log Lik."
msgstr "次优对数似然"

msgid "Degenerate Candidates"
msgstr "退化候选解"

msgid "Min. Component n (ESS)"
msgstr "最小成分 n（ESS）"

msgid "Min. Component Events"
msgstr "最小成分事件数"

msgid "Optimizer Converged"
msgstr "优化器已收敛"

msgid "Hessian Positive Definite"
msgstr "Hessian 正定"

msgid "yes"
msgstr "是"

msgid "no"
msgstr "否"

msgid "Estimation warning: %1$s"
msgstr "估计警告：%1$s"

msgid ""
"The reported solution was reached by only %1$i of %2$i starts; the estimates "
"might be a local optimum. Consider more random starts."
msgstr ""
"所报告的解仅由 %1$i/%2$i 个起始值达到；估计值可能是局部最优。请考虑增加随机起"
"始值。"

msgid ""
"All candidate solutions were flagged as degenerate or failed to converge; "
"the reported estimates may be unreliable. Consider fewer components or more "
"starting values."
msgstr ""
"所有候选解都被标记为退化或未能收敛；所报告的估计值可能不可靠。请考虑减少成分"
"数或增加起始值。"

msgid ""
"The selected solution triggered component diagnostics despite satisfying the "
"spread bound. Inspect the component sizes and dispersion before interpreting "
"the mixture."
msgstr ""
"所选解虽满足离散度界，但触发了成分诊断。在解释混合模型前请检查各成分的大小和"
"离散程度。"

msgid ""
"The smallest component is supported by %1$.1f effective events; such a "
"component is weakly identified. Consider fewer components."
msgstr "最小成分仅由 %1$.1f 个有效事件支撑；该成分识别较弱。请考虑减少成分数。"

msgid ""
"All components coincide; the mixture is not identified and its standard "
"errors are unreliable. Consider fewer components."
msgstr "所有成分重合；混合模型不可识别，其标准误不可靠。请考虑减少成分数。"

msgid ""
"Components %1$s coincide; the mixture is not identified and its standard "
"errors are unreliable. Consider fewer components."
msgstr "成分 %1$s 重合；混合模型不可识别，其标准误不可靠。请考虑减少成分数。"

msgid ""
"The Hessian or parameter covariance could not be used reliably; standard "
"errors and confidence intervals may be unavailable or unreliable."
msgstr "Hessian 或参数协方差无法可靠使用；标准误和置信区间可能不可用或不可靠。"

msgid ""
"Each row is treated as an independent observation. Repeated intervals from "
"the same subject are not linked to a common mixture component."
msgstr "每一行都视为独立观测。同一受试者的重复区间不会关联到同一混合成分。"

msgid ""
"The log-likelihood is lower than that of the nested model with %1$s; the "
"reported estimates are a local optimum. Consider more random starts."
msgstr ""
"对数似然低于含 %1$s 的嵌套模型；所报告的估计值为局部最优。请考虑增加随机起始"
"值。"

msgid "%1$s model %2$s with %3$s%4$s"
msgstr "%1$s 模型 %2$s，含 %3$s%4$s"

msgid "%1$s and %2$s"
msgstr "%1$s和%2$s"

msgid "mixing probability"
msgstr "混合概率"

msgid "Survival Probability"
msgstr "生存概率"

msgid "Failure Probability"
msgstr "失效概率"

msgid "Density"
msgstr "密度"

msgid "Hazard"
msgstr "风险率"

msgid "Cumulative Hazard"
msgstr "累积风险"

msgid "Restricted Mean Survival Time"
msgstr "限制平均生存时间"

msgid "No observations are available in this stratum."
msgstr "该层中没有可用观测。"

msgid ""
"The model failed to produce predictions. Consider simplifying the model."
msgstr "模型未能生成预测。请考虑简化模型。"

msgid "No finite predictions are available for this plot."
msgstr "此图没有可用的有限预测值。"

msgid "Distribution / Component"
msgstr "分布 / 成分"

msgid "No positive predictions are available for a logarithmic y-axis."
msgstr "对数 y 轴没有可用的正预测值。"

msgid "RMST"
msgstr "RMST"

msgid "%1$s (log scale)"
msgstr "%1$s（对数刻度）"

msgid "Fitted density"
msgstr "拟合密度"

msgid "Component 1"
msgstr "成分 1"

msgid "Mixture"
msgstr "混合"

msgid ""
"Membership probabilities were specified in an incorrect format. Try '0.95, "
"0.99'."
msgstr "成员概率的指定格式不正确。请尝试“0.95, 0.99”。"

msgid "Membership probabilities must be greater than 0.5 and less than 1."
msgstr "成员概率必须大于 0.5 且小于 1。"

msgid "Membership probabilities must be distinct."
msgstr "成员概率必须互不相同。"

msgid "The selected predictor has no fitted model term. Choose Linear or Log."
msgstr "所选预测变量没有拟合模型项。请选择线性或对数。"

msgid ""
"The displayed models use different transformations for this predictor. "
"Choose Linear or Log, or display the models separately."
msgstr ""
"所显示的模型对该预测变量使用了不同的变换。请选择线性或对数，或分别显示这些模"
"型。"

msgid ""
"Polynomial, spline and Eyring specifications contain multiple model terms. "
"Choose Linear or Log for this axis."
msgstr "多项式、样条和 Eyring 设定包含多个模型项。请为此轴选择线性或对数。"

msgid ""
"This model-term transformation is not invertible across the displayed "
"predictor range. Choose Linear or Log."
msgstr "该模型项变换在所显示的预测变量范围内不可逆。请选择线性或对数。"

msgid "1 / %s"
msgstr "1 / %s"

msgid "1 / (k_B %1$s) (eV⁻¹; temperature in Kelvin)"
msgstr "1 / (k_B %1$s)（eV⁻¹；温度单位为开尔文）"

msgid "Standardized %s"
msgstr "标准化 %s"

msgid "A logarithmic axis requires positive predictor values."
msgstr "对数轴要求预测变量值为正。"

msgid ""
"No finite predictions remain after the selected axis transformations. Choose "
"a different scale or evaluation range."
msgstr "在所选轴变换后没有剩余的有限预测值。请选择其他刻度或评估范围。"

msgid "A logarithmic plot range requires positive predictor values."
msgstr "对数绘图范围要求预测变量值为正。"

msgid "The plot range for %s requires finite scalar values or expressions."
msgstr "%s 的绘图范围要求有限标量值或表达式。"

msgid "From must be smaller than To for the plot range of %s."
msgstr "%s 的绘图范围起点必须小于终点。"

msgid "The logarithmic plot range for %s must be positive."
msgstr "%s 的对数绘图范围必须为正。"

msgid "The plot range for %s is outside its fitted transformation's domain."
msgstr "%s 的绘图范围超出其拟合变换的定义域。"

msgid "%1$s%% CI"
msgstr "%1$s%% 置信区间"

msgid "%1$s%% Lower Bound"
msgstr "%1$s%% 下限"

msgid "%1$s%% Upper Bound"
msgstr "%1$s%% 上限"

msgid ""
"Some confidence bounds are missing because simulated predictions could not "
"be evaluated (%1$i of %2$i evaluations)."
msgstr "部分置信限缺失，因为模拟预测无法计算（%2$i 次评估中的 %1$i 次）。"

msgid "Some confidence bounds are infinite or exceed numerical range."
msgstr "部分置信限为无穷大或超出数值范围。"

msgid "Custom reference values require exactly one row."
msgstr "自定义参照值必须恰好包含一行。"

msgid "Reference value for %1$s must be an existing factor level."
msgstr "%1$s 的参照值必须是现有的因子水平。"

msgid "Reference value for %1$s must be one finite number or expression."
msgstr "%1$s 的参照值必须是一个有限数字或表达式。"

msgid ""
"The reference value of %1$s is outside its transformation domain. Choose "
"Average or valid Custom values."
msgstr "%1$s 的参照值超出其变换定义域。请选择平均值或有效的自定义值。"

msgid ""
"Contour levels must be finite values or numeric expressions separated by "
"commas."
msgstr "等高线水平必须是以逗号分隔的有限值或数值表达式。"

msgid "Probability contour levels must be between 0 and 1."
msgstr "概率等高线水平必须介于 0 与 1 之间。"

msgid "Contour levels must be non-negative."
msgstr "等高线水平必须为非负。"

msgid "Computing common contour levels"
msgstr "正在计算公共等高线水平"

msgid "A logarithmic heatmap scale requires positive predicted values."
msgstr "对数热图刻度要求预测值为正。"

msgid "Heatmap limits require finite scalar values or expressions."
msgstr "热图范围要求有限标量值或表达式。"

msgid "From must be smaller than To for the heatmap scale."
msgstr "热图刻度的起点必须小于终点。"

msgid "Probability heatmap limits must be between 0 and 1."
msgstr "概率热图范围必须介于 0 与 1 之间。"

msgid "Heatmap limits must be non-negative."
msgstr "热图范围必须为非负。"

msgid "Logarithmic heatmap limits must be positive."
msgstr "对数热图范围必须为正。"

msgid "Percentile %1$s"
msgstr "百分位数 %1$s"

msgid "Select a mean, percentile or time-evaluated measure for predictions."
msgstr "请为预测选择均值、百分位数或按时间评估的度量。"

msgid "The prediction input contains no observations."
msgstr "预测输入不包含任何观测。"

msgid "Select an existing CSV file for custom predictions."
msgstr "请选择一个现有的 CSV 文件用于自定义预测。"

msgid ""
"The prediction CSV file could not be read. Use a comma-separated file with a "
"header row."
msgstr "无法读取预测 CSV 文件。请使用带表头行的逗号分隔文件。"

msgid "The prediction CSV file contains duplicate column names."
msgstr "预测 CSV 文件包含重复的列名。"

msgid "The prediction CSV file is missing these columns: %1$s."
msgstr "预测 CSV 文件缺少以下列：%1$s。"

msgid "Add at least one observation to the prediction input table."
msgstr "请至少向预测输入表添加一条观测。"

msgid ""
"The prediction input table does not match the predictors. Reset the table "
"and enter the observations again."
msgstr "预测输入表与预测变量不匹配。请重置表格并重新输入观测。"

msgid "Prediction row %1$i: '%2$s' must be one of these subgroup levels: %3$s."
msgstr "预测第 %1$i 行：“%2$s”必须是以下子组水平之一：%3$s。"

msgid ""
"Prediction row %1$i specifies a subgroup combination absent from the fitting "
"data."
msgstr "预测第 %1$i 行指定的子组组合在拟合数据中不存在。"

msgid "Blank values for %1$s in %2$s use the default profile level %3$s."
msgstr "%2$s 中 %1$s 的空值将使用默认剖面水平 %3$s。"

msgid ""
"Prediction row %1$i: the value of '%2$s' is outside the domain of its model "
"transformation."
msgstr "预测第 %1$i 行：“%2$s”的值超出其模型变换的定义域。"

msgid "Prediction row %1$i: '%2$s' must be one of these levels: %3$s."
msgstr "预测第 %1$i 行：“%2$s”必须是以下水平之一：%3$s。"

msgid "Prediction row %1$i: '%2$s' requires one finite numeric value%3$s."
msgstr "预测第 %1$i 行：“%2$s”需要一个有限数值%3$s。"

msgid "Predictions"
msgstr "预测"

msgid "Observation"
msgstr "观测"

msgid "%1$s: %2$s"
